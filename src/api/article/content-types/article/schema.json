{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string"
    },
    "resume": {
      "type": "richtext"
    },
    "contenu": {
      "type": "richtext"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "date": {
      "type": "datetime"
    },
    "datePublication": {
      "type": "datetime"
    },
    "priorite": {
      "type": "string"
    },
    "auteur": {
      "type": "string"
    },
    "choixRedaction": {
      "type": "boolean"
    },
    "format": {
      "type": "string"
    },
    "categorie": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::categorie.categorie",
      "inversedBy": "article"
    },
    "sous_categorie": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::sous-categorie.sous-categorie"
    }
  }
}
