{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titre": {
      "type": "string"
    },
    "resume": {
      "type": "richtext"
    },
    "contenu": {
      "type": "richtext"
    },
    "image": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": true
    },
    "categorie": {
      "type": "enumeration",
      "enum": [
        "Sport",
        "Afrique",
        "International",
        "Société",
        "Politique",
        "Culture",
        "Fais Divers",
        "Tech",
        "Education"
      ]
    },
    "sousCategorie": {
      "type": "enumeration",
      "enum": [
        "Football"
      ]
    },
    "date": {
      "type": "datetime"
    },
    "datePublication": {
      "type": "datetime"
    },
    "priorite": {
      "type": "string"
    },
    "auteur": {
      "type": "string"
    },
    "choixRedaction": {
      "type": "boolean"
    },
    "format": {
      "type": "string"
    }
  }
}
